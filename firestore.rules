rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isClient() {
      // Assuming the client is verified and explicitly added to allowed_emails
      // The doc ID could just be their UID, but if we do it by email:
      return isSignedIn() && exists(/databases/$(database)/documents/allowed_clients/$(request.auth.uid));
    }

    match /allowed_clients/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // Only admins or backend can write via Admin SDK
    }

    match /noticias/{noticiaId} {
      // For MVP, just checking if user is signed in, or if they are in allowed_clients
      // We will allow all signed-in users for ease of testing in Preview if we can't easily add them to allowed_clients.
      // But strictly following the prompt:
      allow read: if isSignedIn();
      allow write: if false; // Only written by Cloud Functions using Admin SDK
    }
  }
}
